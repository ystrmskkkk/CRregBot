# Скопируйте этот файл в .env и заполните. Файл .env не публикуется.

# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Username бота без @, нужен для кнопки «Зарегистрироваться» в постах канала
BOT_USERNAME=

# Telegram ID админов через запятую (узнать свой — @userinfobot)
ADMIN_IDS=

# Канал для объявления чемпиона (@username или числовой id). Пусто — не публиковать
CHANNEL_USERNAME=

# Необязательные настройки
DB_PATH=tournament.db
MAX_PARTICIPANTS=0
READINESS_TIMEOUT_MINUTES=10
